# These get set in the Netlify dashboard (Site settings -> Environment variables),
# NOT committed to git. This file is just a reference for which ones you need.

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

TARGET_USER_ID=U0XXXXXXX
TARGET_EMOJI=sparkling_heart
COUNTER_CHANNEL_ID=C0XXXXXXX

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: set to "true" if you want the count to go back down when a
# reaction is removed, instead of being an all-time cumulative tally.
DECREMENT_ON_REMOVE=false
