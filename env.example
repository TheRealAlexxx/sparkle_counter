# Slack app credentials (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# The Slack user ID of @gabin (NOT the username).
# Find it via: click their profile in Slack -> "More" (or "..." ) -> "Copy member ID"
# It looks like U012ABC3DEF
TARGET_USER_ID=U0XXXXXXX

# The emoji name to track, without colons
TARGET_EMOJI=sparkling_heart

# The public channel where the running counter gets posted/updated.
# Use the channel ID (e.g. C012ABC3DEF), not the #name.
# The bot must be invited to this channel: /invite @YourBotName
COUNTER_CHANNEL_ID=C0XXXXXXX
